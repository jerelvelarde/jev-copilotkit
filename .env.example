# Add at least one provider key. Create a Jev key at https://console.typesafe.ai
TYPESAFE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
JEV_MODEL=jev-latest
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_MODEL=claude-sonnet-5
GOOGLE_MODEL=gemini-3.8-flash
# Set a descriptive contact User-Agent if deploying beyond localhost.
WIKIPEDIA_USER_AGENT=JevCopilotKitWikiRace/0.1 (https://github.com/jerelvelarde/jev-copilotkit)
