# Required for live Jev. Create a key at https://console.typesafe.ai
TYPESAFE_API_KEY=
# Optional: enables all three comparison lanes via OpenRouter.
OPENROUTER_API_KEY=
JEV_MODEL=jev-latest
BASELINE_MODEL_1=openai/gpt-4.1-mini
BASELINE_MODEL_2=anthropic/claude-haiku-4.5
BASELINE_MODEL_3=anthropic/claude-sonnet-4.6
# Set a descriptive contact User-Agent if deploying beyond localhost.
WIKIPEDIA_USER_AGENT=WikiRaceCopilotKit/0.1 (local development demo)
